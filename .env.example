# Copy to .env and fill in. Never commit .env. In production, set these as the
# hosting platform's environment variables / secret manager instead of a file.

# Where the app lives under the web server (http://localhost/orbitcare)
APP_BASE_URL=/orbitcare
APP_DEBUG=false

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:@127.0.0.1:3306/orbitcare

# Long random string. Used to pseudonymise IP addresses in audit logs and rate limits.
AUTH_SECRET=

# Signed-in sessions end after this many minutes without activity
SESSION_IDLE_MINUTES=120

# Extra origins allowed to call /api (comma-separated). Empty = same origin only.
CORS_ALLOWED_ORIGINS=

# Recorded-data replay speed (1 = real time)
REPLAY_SPEED=1

# Online AI (server-side only). Used whenever there is a link to the ground; without it,
# OrbitCare's on-board rule-based analysis answers. Check with: php cli/check-ai.php
#   AI_PROVIDER=gemini   key: https://aistudio.google.com/apikey
#   Free tier: Google may use prompts to improve its products — OrbitCare sends no names or IDs,
#   and the demo uses public recorded data. Use a paid key before real crew data.
AI_PROVIDER=
AI_API_KEY=
AI_API_BASE_URL=
# Flash-Lite has the largest free daily quota; change if check-ai.php says it is not available.
AI_MODEL=gemini-flash-lite-latest

# Official medical sources (free): MedlinePlus (no key) and openFDA (optional free key,
# https://open.fda.gov/apis/authentication/). MEDICAL_SOURCES=off disables both.
MEDICAL_SOURCES=on
OPENFDA_API_KEY=

# Readings from a worn device (the vest) — off: live data comes from the PhysioNet recordings.
# DEVICE_INPUT=on opens POST /api/device/readings (see docs/DEVICE_SIMULATION.md).
DEVICE_INPUT=off

# External medical API (server-side only)
MEDICAL_API_KEY=
MEDICAL_API_BASE_URL=
